---
import type { ImageMetadata } from "astro";
import { renderPhoto, GRID_SIZES } from "../lib/photos";
import Lightbox from "./Lightbox.astro";
import { site as siteInfo } from "../config";
import {
  digital as digitalMeta,
  analog as analogMeta,
  type GalleryPhoto,
} from "../data/galleries";

interface Props {
  collection: "digital" | "analog";
}
const { collection } = Astro.props;

// Both globs must be static string literals (Vite requirement); we pick one.
// Add or remove files in these folders and the gallery updates. Order comes
// from the per-photo entries in src/data/galleries.ts, so filenames don't need
// renumbering when a photo is added later.
const digital = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);
const analog = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/analog/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);

const files = collection === "analog" ? analog : digital;

// Per-photo descriptions live in src/data/galleries.ts, keyed by filename.
const meta = new Map<string, GalleryPhoto>(
  (collection === "analog" ? analogMeta : digitalMeta).map((e) => [e.file, e]),
);

// Sort by filename (numeric, descending) for a stable order.
const entries = Object.entries(files).sort(([pathA], [pathB]) => {
  return pathB.localeCompare(pathA, undefined, { numeric: true });
});

// Fallback alt text from the filename ("01-snowy-harbor.jpg" -> "Snowy harbor")
// for photos without a description yet, so alt / SEO text is never empty.
function captionFor(path: string, index: number): string {
  const base = path
    .split("/")
    .pop()!
    .replace(/\.[^.]+$/, "");
  const words = base
    .replace(/^[\s\d_-]+/, "")
    .replace(/[-_]+/g, " ")
    .trim();
  if (!words) return `Photograph ${index + 1}`;
  return words.charAt(0).toUpperCase() + words.slice(1);
}

const photos = await Promise.all(
  entries.map(async ([path, mod], i) => {
    const photo = await renderPhoto(mod.default);
    const entry = meta.get(path.split("/").pop()!);
    const quote = entry?.quote.trim() ?? "";
    return {
      ...photo,
      quote,
      alt: captionFor(path, i),
      entry,
      width: mod.default.width,
      height: mod.default.height,
      ratio: mod.default.height / mod.default.width,
    };
  }),
);

// Structured data: an ImageGallery of ImageObjects attributed to the photographer.
// Include the quote as the image description when present.
const base = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: `${collection.charAt(0).toUpperCase() + collection.slice(1)} — ${siteInfo.name}`,
  url: `${base}${Astro.url.pathname}`,
  isPartOf: { "@id": `${base}/#website` },
  author: { "@id": `${base}/#person` },
  image: photos.map((p) => ({
    "@type": "ImageObject",
    contentUrl: `${base}${p.full}`,
    name: p.alt,
    ...(p.quote ? { description: p.quote } : {}),
    creator: { "@id": `${base}/#person` },
    copyrightHolder: { "@id": `${base}/#person` },
    creditText: siteInfo.name,
    copyrightNotice: `© ${siteInfo.name}`,
    license: `${base}/license`,
    acquireLicensePage: `${base}/contact`,
  })),
};
---

{
  photos.length === 0 ? (
    <p class="empty">
      No photos yet. Drop image files into <code>src/assets/{collection}/</code>{" "}
      and they'll appear here.
    </p>
  ) : (
    <section class="calendar-grid" aria-label={`${collection} photographs`}>
      {photos.map((photo, i) => (
        <figure class="calendar-item" data-ratio={photo.ratio}>
          <button
            class="photo-tile"
            type="button"
            aria-label={`${photo.alt} — view larger`}
            data-full={photo.full}
            data-alt={photo.alt}
            data-quote={photo.quote}
          >
            <img
              class="photo__img"
              src={photo.src}
              srcset={photo.srcset}
              sizes={GRID_SIZES}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading={i < 4 ? "eager" : "lazy"}
              decoding="async"
              draggable={false}
            />
          </button>
          {photo.quote && (
            <figcaption class="calendar-caption">
              <p class="calendar-quote">{photo.quote}</p>
            </figcaption>
          )}
        </figure>
      ))}
    </section>
  )
}

<Lightbox />

<script is:inline>
  (() => {
    const grid = document.querySelector(".calendar-grid");
    if (!grid) return;

    const photos = [...grid.querySelectorAll(".calendar-item")];
    if (!photos.length) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let columns = [];
    let frame = 0;

    const columnCount = () =>
      window.innerWidth > 1024 ? 3 : window.innerWidth > 640 ? 2 : 1;

    const arrangeColumns = () => {
      const count = columnCount();
      columns = Array.from({ length: count }, () => {
        const column = document.createElement("div");
        column.className = "calendar-column";
        return column;
      });
      const heights = columns.map(() => 0);

      photos.forEach((photo) => {
        const columnIndex = heights.indexOf(Math.min(...heights));
        const ratio = Number(photo.dataset.ratio) || 1;
        columns[columnIndex].append(photo);
        heights[columnIndex] += ratio;
      });

      grid.replaceChildren(...columns);
      grid.classList.add("calendar-grid--scroll-columns");
      updateColumnMotion();
    };

    const updateColumnMotion = () => {
      const bounds = grid.getBoundingClientRect();
      const progress = Math.max(
        0,
        Math.min(
          1,
          (window.innerHeight - bounds.top) /
            (window.innerHeight + bounds.height),
        ),
      );
      const amplitude = Math.min(200, window.innerHeight * 0.3);
      const distance = reducedMotion.matches
        ? 0
        : Math.sin(progress * Math.PI) * amplitude;
      columns.forEach((column, index) => {
        const direction = index % 2 === 0 ? -1 : 1;
        column.style.setProperty("--column-shift", `${distance * direction}px`);
      });
    };

    const scheduleMotion = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updateColumnMotion);
    };

    arrangeColumns();
    window.addEventListener("scroll", scheduleMotion, { passive: true });
    window.addEventListener("resize", arrangeColumns);
    reducedMotion.addEventListener("change", scheduleMotion);
  })();
</script>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
