<aside
  class="gallery-prompt"
  aria-label="Invitación a contactar"
  data-gallery-contact-prompt
  hidden
>
  <p>¿Te gustó lo que viste? <span>Hablemos de tu proyecto.</span></p>
  <a href="#gallery-cta" data-contact-link>
    Contáctame <span aria-hidden="true">→</span>
  </a>
  <button type="button" aria-label="Cerrar invitación" data-dismiss>
    <span aria-hidden="true">×</span>
  </button>
</aside>

<script>
  const prompt = document.querySelector<HTMLElement>(
    "[data-gallery-contact-prompt]",
  );
  const contact = document.querySelector<HTMLElement>("#gallery-cta");
  const dismiss = prompt?.querySelector<HTMLButtonElement>("[data-dismiss]");

  if (prompt && contact && dismiss) {
    let dismissed = false;
    let visibilityFrame = 0;

    const updateVisibility = () => {
      const maxScroll =
        document.documentElement.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
      const contactIsVisible =
        contact.getBoundingClientRect().top < window.innerHeight;
      const shouldShow =
        !dismissed && progress >= 0.25 && !contactIsVisible;

      if (shouldShow) {
        prompt.hidden = false;
        cancelAnimationFrame(visibilityFrame);
        visibilityFrame = requestAnimationFrame(() => {
          prompt.classList.add("is-visible");
        });
      } else {
        cancelAnimationFrame(visibilityFrame);
        prompt.classList.remove("is-visible");
      }
    };

    prompt.addEventListener("transitionend", (event) => {
      if (
        event.target === prompt &&
        event.propertyName === "opacity" &&
        !prompt.classList.contains("is-visible")
      ) {
        prompt.hidden = true;
      }
    });
    dismiss.addEventListener("click", () => {
      dismissed = true;
      updateVisibility();
    });
    prompt
      .querySelector<HTMLAnchorElement>("[data-contact-link]")
      ?.addEventListener("click", () => {
        dismissed = true;
        updateVisibility();
      });
    prompt.addEventListener("transitioncancel", () => {
      if (prompt.classList.contains("is-visible")) prompt.hidden = false;
    });
    window.addEventListener("scroll", updateVisibility, { passive: true });
    window.addEventListener("resize", updateVisibility);
    updateVisibility();
  }
</script>

<style>
  .gallery-prompt {
    position: fixed;
    z-index: 25;
    left: calc(var(--sidebar-w) + (100vw - var(--sidebar-w)) / 2);
    bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: calc(100vw - 2rem);
    padding: 0.8rem 1rem 0.8rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 8px 30px rgb(0 0 0 / 12%);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.75rem);
    transition:
      opacity 240ms ease,
      transform 240ms ease;
  }

  .gallery-prompt.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .gallery-prompt[hidden] {
    display: none;
  }

  .gallery-prompt p {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .gallery-prompt p span {
    color: var(--muted);
  }

  .gallery-prompt a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .gallery-prompt a span {
    transition: transform 0.2s ease;
  }

  .gallery-prompt a:hover span {
    transform: translateX(3px);
  }

  .gallery-prompt button {
    display: grid;
    flex: none;
    width: 2rem;
    height: 2rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 1.35rem;
    cursor: pointer;
  }

  .gallery-prompt button:hover {
    background: var(--line);
    color: var(--fg);
  }

  @media (max-width: 1023px) {
    .gallery-prompt {
      left: 50%;
    }
  }

  @media (max-width: 640px) {
    .gallery-prompt {
      gap: 0.7rem;
      width: max-content;
      padding: 0.65rem 0.7rem 0.65rem 0.9rem;
    }

    .gallery-prompt p,
    .gallery-prompt a {
      font-size: 0.85rem;
    }

    .gallery-prompt p span {
      display: block;
    }
  }
</style>
