---
import Layout from "../layouts/Layout.astro";
import { site, social } from "../config";

// ── Edit everything below to tell your own story. ───────────────────────────
// The little "fact" cards are just example fields — rename them, add more, or
// remove the whole block if you prefer plain prose.
const facts = [
    {
        label: "Actualmente",
        line: "Fotógrafo y programador",
        muted: "Santiago, Chile",
    },
    {
        label: "Fotografio",
        line: "Solo Digital (por ahora)",
        muted: "Me guio por mi instinto",
    },
    { label: "Desde", line: "2024", muted: "No me canso de hacer esto" },
];
---

<Layout
    title="About"
    description={`Desde ${site.name} — fotógrafo y programador.`}
>
    <article class="page prose">
        <h1 class="page__title">Para mi</h1>

        <p class="lede">
            Soy {site.name} — un fotógrafo y programador, y la persona detras de las
            fotos en este sitio.
        </p>

        <p>
            La fotografia para mi es una forma de canalizar lo que veo e
            inmortalizar esos momentos, un lenguaje que no necesita palabras.
        </p>
        <p>
            Puede no parecer importante al momento de tomar una foto, recuerdo
            un tiempo llegue a pensar asi, creia que no era necesaria la
            fotografia — Para el niño que pensaba asi, quiero que sienta lo
            mismo que yo cuando tomo las fotos.
        </p>

        <div class="facts">
            {
                facts.map((f) => (
                    <section class="fact">
                        <h2 class="fact__label">{f.label}</h2>
                        <p class="fact__line">{f.line}</p>
                        <p class="fact__muted">{f.muted}</p>
                    </section>
                ))
            }
        </div>

        <p>
            <a class="text-link" href="/contact" rel="noopener noreferrer">
                Quieres hablar? →
            </a>
        </p>
    </article>
</Layout>
