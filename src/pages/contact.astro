---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { social } from "../config";

const links = [
    {
        name: "whatsapp" as const,
        label: "WhatsApp",
        handle: "Haz tu consulta, no muerdo",
        href: social.whatsapp,
    },
    {
        name: "instagram" as const,
        label: "Instagram",
        handle: "@daichho",
        href: social.instagram,
    },
    {
        name: "linkedin" as const,
        label: "LinkedIn",
        handle: "in/david-astudillo-599ba9220",
        href: social.linkedin,
    },
    {
        name: "github" as const,
        label: "GitHub",
        handle: "@daveadbeel",
        href: social.github,
    },
];
---

<Layout
    title="Contacto"
    description="Formas de seguir mi trabajo y ponerme en contacto."
>
    <article class="page prose">
        <h1 class="page__title">¿Buscas fotógrafo?</h1>
        <p class="lede">Escríbeme y cuéntame sobre tu proyecto.</p>

        <ul class="contact-list">
            {
                links.map((link) => (
                    <li>
                        <a
                            class="contact-card"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <span class="contact-card__icon">
                                <Icon name={link.name} />
                            </span>
                            <span class="contact-card__text">
                                <span class="contact-card__label">
                                    {link.label}
                                </span>
                                <span class="contact-card__handle">
                                    {link.handle}
                                </span>
                            </span>
                            <span
                                class="contact-card__arrow"
                                aria-hidden="true"
                            >
                                →
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <p>
            <a class="text-link" href="/license">Uso de imágenes y licencia →</a
            >
        </p>
        <p>
            <a class="text-link" href="/privacy">Políticas de privacidad →</a>
        </p>
    </article>
</Layout>
